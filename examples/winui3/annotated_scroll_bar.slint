import { Palette } from "std-widgets.slint";
import { Button } from "../../apps/lumatune/ui/components/basic-input/button.slint";
import { AnnotatedScrollBar, AnnotatedScrollBarBehavior, AnnotatedScrollBarLabel, AnnotatedScrollBarMarker, AnnotatedScrollBarScrollingKind } from "../../apps/lumatune/ui/components/scrolling/annotated_scroll_bar.slint";

export { AnnotatedScrollBarBehavior, AnnotatedScrollBarLabel, AnnotatedScrollBarMarker, AnnotatedScrollBarScrollingKind }

export component AnnotatedScrollBarExample inherits Window {
    title: "AnnotatedScrollBar";
    background: #f3f3f3;
    min-width: 684px;
    preferred-height: 614px;
    default-font-family: "Segoe UI";

    in property <brush> accent: Palette.accent-background;
    private property <bool> short-bar;
    private property <bool> wide;
    private property <bool> rtl;
    private property <bool> cancel-requests;
    private property <bool> custom-step;
    private property <int> columns: root.wide ? 4 : 1;
    private property <length> extent: ceil(250 / root.columns) * 90px + 4px;
    private property <length> limit: max(0px, root.extent - grid.height);
    private property <string> kind;
    private property <int> requests;
    private property <int> commits;

    pure function row-start(item: int) -> length {
        return floor(item / root.columns) * 90px;
    }

    pure function color-name(offset: length) -> string {
        return offset <= root.row-start(31) ? "Azure" : offset <= root.row-start(81) ? "Crimson"
            : offset <= root.row-start(89) ? "Cyan" : offset <= root.row-start(159) ? "Fuchsia" : "Gold";
    }

    function scroll-to(offset: length) {
        grid.content-y = -clamp(offset, 0px, root.limit);
    }

    changed limit => { root.scroll-to(-grid.content-y); }

    HorizontalLayout {
        x: 24px;
        y: 16px;
        width: parent.width - 48px;
        height: 32px;
        spacing: 8px;
        alignment: start;
        Button { text: "Short rail"; clicked => { root.short-bar = !root.short-bar; } }
        Button { text: "Four columns"; clicked => { root.wide = !root.wide; } }
        Button { text: "Mirror RTL"; clicked => { root.rtl = !root.rtl; } }
        Button { text: "Cancel scroll"; clicked => { root.cancel-requests = !root.cancel-requests; } }
        Button { text: "Jump to Gold"; clicked => { root.scroll-to(root.row-start(160)); } }
        Button { text: "Step 90"; clicked => { root.custom-step = !root.custom-step; } }
    }

    FocusScope {
        x: root.rtl ? 24px + bar.width + 4px : 24px;
        y: 68px;
        width: root.columns * 120px + 4px;
        height: 500px;
        accessible-role: groupbox;
        accessible-label: "Color grid";
        key-pressed(event) => {
            let value = -grid.content-y;
            if event.text == Key.UpArrow { root.scroll-to(value - 62.5px); }
            else if event.text == Key.DownArrow { root.scroll-to(value + 62.5px); }
            else if event.text == Key.PageUp { root.scroll-to(value - grid.height); }
            else if event.text == Key.PageDown { root.scroll-to(value + grid.height); }
            else if event.text == Key.Home { root.scroll-to(0px); }
            else if event.text == Key.End { root.scroll-to(root.limit); }
            else { return reject; }
            return accept;
        }

        Rectangle {
            background: #d3d3d3;
            border-radius: 4px;
            clip: true;
            grid := Flickable {
                width: parent.width;
                height: parent.height;
                content-width: self.width;
                content-height: root.extent;
                for index in 250: Rectangle {
                    x: 6px + Math.mod(index, root.columns) * 120px;
                    y: 6px + root.row-start(index);
                    width: 112px;
                    height: 82px;
                    border-radius: 4px;
                    background: index < 32 ? #f0ffff : index < 82 ? #dc143c : index < 90 ? #00ffff
                        : index < 160 ? #ff00ff : #ffd700;
                }
            }
        }
    }

    bar := AnnotatedScrollBar {
        x: root.rtl ? 24px : 28px + root.columns * 120px + 4px;
        y: 68px;
        width: self.preferred-width;
        height: root.short-bar ? 144px : 500px;
        maximum: root.limit;
        viewport-size: grid.height;
        value: -grid.content-y;
        small-change: root.custom-step ? 90px : 0px;
        rtl: root.rtl;
        indicator-color: root.accent;
        labels: [
            { text: "Azure", offset: 0px },
            { text: "Crimson", offset: root.row-start(32) },
            { text: "Cyan", offset: root.row-start(82) },
            { text: "Fuchsia", offset: root.row-start(90) },
            { text: "Gold", offset: root.row-start(160) },
        ];
        detail-label-requested(offset) => { return root.color-name(offset); }
        scrolling(offset, kind) => {
            root.requests += 1;
            root.kind = kind == AnnotatedScrollBarScrollingKind.click ? "click"
                : kind == AnnotatedScrollBarScrollingKind.drag ? "drag"
                : kind == AnnotatedScrollBarScrollingKind.increment-button ? "up" : "down";
            return root.cancel-requests;
        }
        scroll-requested(offset) => {
            root.commits += 1;
            root.scroll-to(offset);
        }
    }

    Text {
        x: 24px;
        y: 588px;
        text: "Offset \{round(bar.effective-value / 1px)} · Requests \{root.requests} · Accepted \{root.commits} · \{root.kind}";
        color: Palette.foreground;
        accessible-label: self.text;
    }
}
