import { Button, Palette } from "std-widgets.slint";
import {
    NavigationView, NavigationViewBehavior, NavigationViewDisplayMode, NavigationViewItem,
    NavigationViewItemKind, NavigationViewMeasurement, NavigationViewPaneDisplayMode, NavigationViewRow, NavigationViewTopLayout,
} from "../../apps/lumatune/ui/components/navigation/navigation_view.slint";

export { NavigationViewBehavior, NavigationViewDisplayMode, NavigationViewItem, NavigationViewItemKind,
    NavigationViewMeasurement, NavigationViewPaneDisplayMode, NavigationViewRow, NavigationViewTopLayout }

export component NavigationViewExample inherits Window {
    title: "LumaTune - NavigationView";
    preferred-width: 1080px;
    preferred-height: 620px;
    min-width: 360px;
    min-height: 320px;
    default-font-family: "Segoe UI";
    in-out property <NavigationViewPaneDisplayMode> mode: NavigationViewPaneDisplayMode.auto;
    out property <string> selected-id: view.selected-id;
    out property <bool> pane-open: view.is-pane-open;
    out property <NavigationViewDisplayMode> display-mode: view.display-mode;
    out property <string> last-invoked;
    private property <string> previous;
    private property <string> current: "home";

    view := NavigationView {
        height: parent.height;
        width: parent.width;
        pane-display-mode: root.mode;
        pane-title: "Library";
        header: root.selected-id == "home" ? "Home" : root.selected-id == "library" ? "Library"
            : root.selected-id == "artists" ? "Artists" : root.selected-id == "albums" ? "Albums"
            : root.selected-id == "favorites" ? "Favorites" : root.selected-id == "history" ? "Listening history"
            : root.selected-id == "settings" || root.selected-id == "$settings" ? "Settings" : "Downloads";
        selected-id: "home";
        is-back-enabled: root.previous != "";
        menu-items: [
            { id: "home", label: "Home", icon: @image-url("../../apps/lumatune/ui/icons/home_16_regular.svg") },
            { id: "group", label: "Your collection", kind: NavigationViewItemKind.header },
            { id: "library", label: "Library", icon: @image-url("../../apps/lumatune/ui/icons/library_16_regular.svg") },
            { id: "artists", parent-id: "library", label: "Artists" },
            { id: "albums", parent-id: "library", label: "Albums" },
            { id: "favorites", label: "Favorites", icon: @image-url("../../apps/lumatune/ui/icons/star_16_regular.svg") },
            { id: "history", label: "Listening history", icon: @image-url("../../apps/lumatune/ui/icons/history_16_regular.svg") },
            { id: "divider", kind: NavigationViewItemKind.separator },
            { id: "downloads", label: "Offline downloads", disabled: true,
                icon: @image-url("../../apps/lumatune/ui/icons/arrow_download_16_regular.svg") },
        ];
        footer-menu-items: [
            { id: "refresh", label: "Refresh", suppress-selection: true, icon: @image-url("../../apps/lumatune/ui/icons/arrow_clockwise_16_regular.svg") },
        ];
        item-invoked(id) => { root.last-invoked = id; }
        selection-changed => {
            if (root.selected-id != root.current) { root.previous = root.current; root.current = root.selected-id; }
        }
        back-requested => { if (root.previous != "") { self.selected-id = root.previous; } }

        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: start;
            Text { text: "Pane display mode"; font-size: 14px; color: Palette.foreground; }
            HorizontalLayout {
                spacing: 4px;
                Button { text: "Auto"; clicked => { root.mode = NavigationViewPaneDisplayMode.auto; } }
                Button { text: "Left"; clicked => { root.mode = NavigationViewPaneDisplayMode.left; } }
                Button { text: "Compact"; clicked => { root.mode = NavigationViewPaneDisplayMode.left-compact; } }
                Button { text: "Minimal"; clicked => { root.mode = NavigationViewPaneDisplayMode.left-minimal; } }
                Button { text: "Top"; clicked => { root.mode = NavigationViewPaneDisplayMode.top; } }
            }
            Text { text: "Selection: " + root.selected-id; font-size: 14px; color: Palette.foreground; }
        }
    }
}
