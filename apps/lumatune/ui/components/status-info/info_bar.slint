import { Button, Palette } from "std-widgets.slint";
import { ContrastTheme, SystemContrastColors } from "../contrast_theme.slint";

export enum InfoSeverity {
    informational,
    success,
    warning,
    error,
}

export enum InfoBarCloseReason {
    close-button,
    programmatic,
}

component InfoBarText inherits Text {
    color: ContrastTheme.colors.active ? ContrastTheme.colors.window-text : Palette.foreground;
    font-size: 14px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
}

component InfoBarAction inherits Rectangle {
    in property <string> text;
    callback clicked();
    private property <SystemContrastColors> contrast: ContrastTheme.colors;

    height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    preferred-width: root.contrast.active ? max(32px, contrast-button.label-width + 24px) : standard-button.preferred-width;

    standard-button := Button {
        width: parent.width;
        height: parent.height;
        visible: !root.contrast.active;
        text: root.text;
        clicked => { root.clicked(); }
    }

    contrast-button := Rectangle {
        visible: root.contrast.active;
        private property <length> label-width: label.preferred-width;
        private property <bool> highlighted: hit.has-hover || hit.pressed;
        border-radius: 4px;
        border-width: focus.has-focus ? 2px : 1px;
        border-color: focus.has-focus ? root.contrast.highlight
            : hit.pressed ? root.contrast.highlight-text
            : hit.has-hover ? root.contrast.highlight
            : transparent;
        background: self.highlighted ? root.contrast.highlight-text : root.contrast.button-face;

        accessible-role: button;
        accessible-label: root.text;
        accessible-action-default => { root.clicked(); }

        label := Text {
            width: parent.width;
            height: parent.height;
            text: root.text;
            font-size: 14px;
            color: contrast-button.highlighted ? root.contrast.highlight : root.contrast.button-text;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }

        hit := TouchArea { clicked => { root.clicked(); } }
        focus := FocusScope {
            width: 0px;
            key-pressed(event) => {
                if (event.text == Key.Space || event.text == Key.Return) {
                    root.clicked();
                    return accept;
                }
                return reject;
            }
        }
    }
}

export component InfoBar inherits Rectangle {
    in-out property <bool> open: true;
    in property <string> title;
    in property <string> message;
    in property <InfoSeverity> severity: InfoSeverity.informational;
    in property <bool> is-icon-visible: true;
    in property <bool> is-closable: true;
    in property <image> icon-source;
    in property <string> action-label;

    callback close-button-clicked();
    // Return true to cancel the close and leave the bar visible.
    callback closing(InfoBarCloseReason) -> bool;
    callback closed(InfoBarCloseReason);
    callback action();

    private property <bool> displayed;
    private property <bool> handling-close;
    private property <SystemContrastColors> contrast: ContrastTheme.colors;
    private property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    private property <brush> icon-color:
        root.contrast.active ? root.contrast.highlight
        : root.severity == InfoSeverity.success ? (root.dark ? #6ccb5f : #0f7b0f)
        : root.severity == InfoSeverity.warning ? (root.dark ? #fce100 : #9d5d00)
        : root.severity == InfoSeverity.error ? (root.dark ? #ff99a4 : #c42b1c)
        : Palette.accent-background;
    private property <image> status-icon:
        root.severity == InfoSeverity.success ? @image-url("../../icons/checkmark_circle_16_filled.svg")
        : root.severity == InfoSeverity.warning ? @image-url("../../icons/error_circle_16_filled.svg")
        : root.severity == InfoSeverity.error ? @image-url("../../icons/info_bar_error_16.svg")
        : @image-url("../../icons/info_16_filled.svg");
    private property <int> content-count: (root.title != "" ? 1 : 0)
        + (root.message != "" ? 1 : 0) + (root.action-label != "" ? 1 : 0);
    private property <length> content-left: root.is-icon-visible ? 46px : 16px;
    private property <length> content-width: max(0px, root.width - root.content-left - 16px - (root.is-closable ? 48px : 0px));
    private property <bool> stacked: root.content-count == 1
        || inline-content.preferred-width > root.content-width || inline-content.preferred-height > 32px;
    private property <length> header-height: root.stacked ? max(48px, stacked-content.preferred-height) : 48px;
    private property <bool> has-custom-icon: root.icon-source.width > 0 && root.icon-source.height > 0;

    // In a spaced layout, remove the bar from the closed callback to reclaim the gap.
    visible: root.displayed;
    min-width: root.content-left + 16px + (root.is-closable ? 48px : 0px);
    horizontal-stretch: 1;
    vertical-stretch: 0;
    height: root.displayed ? root.header-height + custom-content.preferred-height : 0px;
    border-radius: 4px;
    border-width: root.contrast.active ? 2px : 1px;
    border-color: root.contrast.active ? root.contrast.button-text : root.dark ? #0000001a : #0000000f;
    background:
        root.contrast.active ? root.contrast.window
        : root.severity == InfoSeverity.success ? (root.dark ? #393d1b : #dff6dd)
        : root.severity == InfoSeverity.warning ? (root.dark ? #433519 : #fff4ce)
        : root.severity == InfoSeverity.error ? (root.dark ? #442726 : #fde7e9)
        : root.dark ? #ffffff08 : #f6f6f680;

    init => { root.displayed = root.open; }
    changed open => {
        if (root.open) {
            root.displayed = true;
        } else {
            root.request-close(InfoBarCloseReason.programmatic);
        }
    }

    function request-close(reason: InfoBarCloseReason) {
        if (root.displayed && !root.handling-close) {
            root.handling-close = true;
            if (reason == InfoBarCloseReason.close-button) {
                root.close-button-clicked();
            }
            root.open = false;
            if (root.closing(reason)) {
                root.open = true;
            } else {
                root.displayed = false;
                root.closed(reason);
            }
            root.displayed = root.open;
            root.handling-close = false;
        }
    }

    if root.is-icon-visible : Rectangle {
        x: 16px;
        y: 16px;
        width: 16px;
        height: 16px;
        if !root.has-custom-icon : Rectangle {
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: root.contrast.active ? root.contrast.highlight-text : Palette.accent-foreground;
        }
        Image {
            width: 16px;
            height: 16px;
            source: root.has-custom-icon ? root.icon-source : root.status-icon;
            image-fit: contain;
            colorize: root.has-custom-icon ? transparent : root.icon-color;
        }
    }

    // The natural inline width determines when all three elements move to separate rows.
    inline-content := HorizontalLayout {
        x: root.content-left;
        y: 0px;
        width: root.content-width;
        height: 48px;
        alignment: start;
        visible: !root.stacked;

        if root.title != "" : InfoBarText {
            text: root.title;
            font-weight: 600;
            vertical-alignment: center;
        }

        if root.title != "" && root.message != "" : Rectangle { width: 12px; }

        if root.message != "" : InfoBarText {
            text: root.message;
            vertical-alignment: center;
        }

        if root.action-label != "" && (root.title != "" || root.message != "") : Rectangle { width: 16px; }

        if root.action-label != "" : InfoBarAction {
            y: 8px;
            text: root.action-label;
            clicked => { root.action(); }
        }
    }

    stacked-content := VerticalLayout {
        x: root.content-left;
        y: 0px;
        width: root.content-width;
        height: self.preferred-height;
        padding-top: 14px;
        padding-bottom: 18px;
        alignment: start;
        visible: root.stacked;

        if root.title != "" : InfoBarText {
            text: root.title;
            font-weight: 600;
            wrap: word-wrap;
        }

        if root.title != "" && root.message != "" : Rectangle { height: 4px; }

        if root.message != "" : InfoBarText {
            text: root.message;
            wrap: word-wrap;
        }

        if root.action-label != "" && (root.title != "" || root.message != "") : Rectangle { height: 12px; }

        if root.action-label != "" : InfoBarAction {
            width: min(root.content-width, self.preferred-width);
            text: root.action-label;
            clicked => { root.action(); }
        }
    }

    custom-content := VerticalLayout {
        x: root.content-left;
        y: root.header-height;
        width: root.content-width;
        height: self.preferred-height;
        @children
    }

    if root.is-closable : Rectangle {
        x: parent.width - 44px;
        y: 6px;
        width: 38px;
        height: 38px;
        border-radius: 4px;
        private property <bool> highlighted: close-touch.has-hover || close-touch.pressed;
        border-width: close-focus.has-focus ? 2px : 0px;
        border-color: root.contrast.active
            ? root.contrast.highlight
            : Palette.foreground;
        background: root.contrast.active
            ? (self.highlighted ? root.contrast.highlight : transparent)
            : close-touch.pressed ? Palette.foreground.with-alpha(0.025)
            : close-touch.has-hover ? Palette.foreground.with-alpha(0.06)
            : transparent;

        accessible-role: button;
        accessible-label: "关闭";
        accessible-action-default => { close-touch.clicked(); }

        Image {
            width: 16px;
            height: 16px;
            source: @image-url("../../icons/dismiss_16_regular.svg");
            colorize: root.contrast.active
                ? (parent.highlighted ? root.contrast.highlight-text : root.contrast.button-text)
                : Palette.foreground;
        }

        close-touch := TouchArea {
            clicked => { root.request-close(InfoBarCloseReason.close-button); }
        }

        close-focus := FocusScope {
            width: 0px;
            key-pressed(event) => {
                if (event.text == Key.Space || event.text == Key.Return) {
                    close-touch.clicked();
                    return accept;
                }
                return reject;
            }
        }
    }
}
