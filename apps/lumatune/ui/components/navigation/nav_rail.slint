// Generic navigation rail. A vertical list of icon+label entries with an optional
// footer entry pinned to the bottom, a back affordance, and a compact/expanded toggle.
//
// App-agnostic: entries carry a caller-chosen integer `id` and an icon `image`
// (pass `@image-url(...)`); `current` holds the id of the selected entry. The host
// maps its own page enum to/from these ids via the `selected(id)` callback. Icons
// are recolored with `colorize` and the Slint `Palette` semantic colors.

import { Palette } from "std-widgets.slint";

export struct NavEntry {
    id: int,
    icon: image,
    label: string,
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected: false;
    in property <bool> compact: false;
    callback activate();

    height: 36px;
    background: hit.pressed ? Palette.foreground.with-alpha(0.025) : ((root.selected || hit.has-hover) ? Palette.foreground.with-alpha(0.04) : transparent);
    border-radius: 4px;

    animate background { duration: 120ms; }

    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 4px;
        height: root.selected ? 16px : 4px;
        border-radius: 2px;
        background: Palette.accent-background;
        opacity: root.selected ? 1 : 0;

        animate height { duration: 150ms; easing: ease-out; }
        animate opacity { duration: 150ms; }
    }

    Image {
        width: 16px;
        height: 16px;
        x: (min(parent.width, 40px) - 16px) / 2;
        y: (parent.height - 16px) / 2;
        source: root.icon;
        colorize: hit.pressed ? Palette.foreground.with-alpha(0.60) : Palette.foreground.with-alpha(0.85);

        animate colorize { duration: 120ms; }
    }

    Text {
        x: 40px;
        y: 0;
        height: parent.height;
        width: max(parent.width - 52px, 0px);
        text: root.label;
        vertical-alignment: center;
        font-weight: 400;
        color: hit.pressed ? Palette.foreground.with-alpha(0.62) : Palette.foreground;
        font-size: 14px;
        overflow: elide;
        opacity: root.compact ? 0 : 1;
    }

    hit := TouchArea {
        clicked => { root.activate(); }
    }
}

export component NavRail inherits Rectangle {
    // Entries rendered in order between the controls and the footer.
    in property <[NavEntry]> items;
    // Optional entry pinned near the bottom (e.g. settings). Hidden when show-footer is false.
    in property <NavEntry> footer: { id: -1, icon: @image-url("../../icons/settings_16_regular.svg"), label: "" };
    // Id of the currently selected entry. Echoed back through `selected(id)` on click.
    in-out property <int> current: 0;
    in-out property <bool> compact: false;

    in property <bool> show-back: true;
    in property <bool> can-go-back: false;
    in property <bool> show-toggle: true;
    in property <bool> show-footer: true;

    in property <length> expanded-width: 200px;
    in property <length> collapsed-width: 48px;

    // Fired when an entry (including the footer) is activated; carries its id.
    callback selected(int);
    callback back();

    width: root.compact ? root.collapsed-width : root.expanded-width;
    background: Palette.background;
    clip: true;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Palette.foreground.with-alpha(0.03);
    }

    VerticalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        padding-left: 4px;
        padding-right: 4px;
        spacing: 4px;

        if root.show-back : Rectangle {
            width: 40px;
            height: 36px;
            horizontal-stretch: 0;
            border-radius: 4px;
            background: back-hit.has-hover ? Palette.foreground.with-alpha(0.04) : transparent;

            Image {
                width: 16px;
                height: 16px;
                x: (parent.width - 16px) / 2;
                y: (parent.height - 16px) / 2;
                source: @image-url("../../icons/arrow_left_16_regular.svg");
                colorize: root.can-go-back ? Palette.foreground : Palette.foreground.with-alpha(0.35);
            }

            back-hit := TouchArea {
                enabled: root.can-go-back;
                clicked => { root.back(); }
            }
        }

        if root.show-toggle : Rectangle {
            width: 40px;
            height: 36px;
            horizontal-stretch: 0;
            border-radius: 4px;
            background: nav-toggle.pressed ? Palette.foreground.with-alpha(0.03) : (nav-toggle.has-hover ? Palette.foreground.with-alpha(0.04) : transparent);

            animate background { duration: 100ms; }

            Image {
                width: 16px;
                height: 16px;
                x: (parent.width - 16px) / 2;
                y: (parent.height - 16px) / 2;
                source: @image-url("../../icons/line_horizontal_3_16_regular.svg");
                colorize: nav-toggle.pressed ? Palette.foreground.with-alpha(0.72) : Palette.foreground;

                animate colorize { duration: 100ms; }
            }

            nav-toggle := TouchArea {
                clicked => { root.compact = !root.compact; }
            }
        }

        for entry in root.items : NavItem {
            label: entry.label;
            icon: entry.icon;
            compact: root.compact;
            selected: root.current == entry.id;
            activate => {
                root.current = entry.id;
                root.selected(entry.id);
            }
        }

        Rectangle { }

        if root.show-footer : NavItem {
            label: root.footer.label;
            icon: root.footer.icon;
            compact: root.compact;
            selected: root.current == root.footer.id;
            activate => {
                root.current = root.footer.id;
                root.selected(root.footer.id);
            }
        }
    }
}
