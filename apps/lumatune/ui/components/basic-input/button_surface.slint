import { Palette } from "std-widgets.slint";

export component ButtonSurface inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> hovered;
    in property <bool> pressed;
    in property <bool> selected;
    in property <color> accent: Palette.accent-background;
    out property <color> foreground: root.selected
        ? (root.dark ? (root.pressed || !root.enabled ? #00000080 : black)
            : (root.pressed ? #ffffffb3 : white))
        : (!root.enabled ? (root.dark ? #ffffff5e : #0000005c)
            : root.pressed ? (root.dark ? #ffffffc9 : #0000009e) : (root.dark ? white : #000000e4));

    private property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    private property <bool> outer-fill: root.enabled && root.selected;
    private property <brush> fill: root.selected
        ? (!root.enabled ? (root.dark ? #ffffff29 : #00000037)
            : root.accent.with-alpha(root.pressed ? 0.8 : root.hovered ? 0.9 : 1))
        : (!root.enabled || root.pressed ? (root.dark ? #ffffff0a : #f9f9f94d)
            : root.hovered ? (root.dark ? #ffffff14 : #f9f9f980) : Palette.control-background);
    private property <brush> stroke: root.selected
        ? (!root.enabled || root.pressed ? transparent : (root.dark
            ? @linear-gradient(180deg, #ffffff14 90.67%, #ffffff12 100%)
            : @linear-gradient(180deg, #ffffff14 90.67%, #00000066 100%)))
        : (!root.enabled || root.pressed ? (root.dark ? #ffffff12 : #0000000f) : (root.dark
            ? @linear-gradient(180deg, #ffffff17 0%, #ffffff12 8.33%)
            : @linear-gradient(180deg, #0000000f 90.58%, #00000029 100%)));

    border-radius: 4px;
    min-width: body.min-width;
    min-height: max(32px, body.min-height);
    preferred-width: round(body.preferred-width / 2px) * 2px;
    preferred-height: round(max(32px, body.preferred-height) / 2px) * 2px;
    animate fill { duration: 83ms; easing: linear; }

    Rectangle {
        border-width: 1px;
        border-color: root.stroke;
        border-radius: root.border-radius;
        background: root.outer-fill ? root.fill : transparent;

        if !root.outer-fill: Rectangle {
            x: 1px;
            y: 1px;
            width: max(0px, parent.width - 2px);
            height: max(0px, parent.height - 2px);
            border-radius: max(0px, root.border-radius - 1px);
            background: root.fill;
        }
    }

    body := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;
        alignment: center;

        if root.text != "": Text {
            text: root.text;
            color: root.foreground;
            font-family: "Segoe UI Variable Text";
            font-size: 14px;
            vertical-alignment: center;
            accessible-role: none;
        }
        @children
    }
}
