import { Palette } from "std-widgets.slint";
import { ButtonInput, ButtonFocusVisual } from "button_input.slint";

export enum ToggleButtonState { unchecked, checked, indeterminate }

export component ToggleButton inherits Rectangle {
    in property <string> text;
    in property <string> accessible-name: root.text;
    in property <bool> enabled: true;
    in property <bool> is-three-state;
    in property <color> accent: Palette.accent-background;
    in-out property <ToggleButtonState> check-state: ToggleButtonState.unchecked;
    out property <bool> has-focus: input.has-focus;
    out property <color> foreground: root.selected
        ? (root.dark ? (input.pressed || !root.enabled ? #00000080 : black)
            : (input.pressed ? #ffffffb3 : white))
        : (!root.enabled ? (root.dark ? #ffffff5e : #0000005c)
            : input.pressed ? (root.dark ? #ffffffc9 : #0000009e) : (root.dark ? white : #000000e4));

    callback clicked();
    callback checked();
    callback unchecked();
    callback indeterminate();

    private property <ToggleButtonState> reported-state;
    private property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    private property <bool> selected: root.check-state == ToggleButtonState.checked;
    private property <bool> outer-fill: root.enabled && root.selected;
    private property <brush> fill: root.selected
        ? (!root.enabled ? (root.dark ? #ffffff29 : #00000037)
            : root.accent.with-alpha(input.pressed ? 0.8 : input.has-hover ? 0.9 : 1))
        : (!root.enabled || input.pressed ? (root.dark ? #ffffff0a : #f9f9f94d)
            : input.has-hover ? (root.dark ? #ffffff14 : #f9f9f980) : Palette.control-background);
    private property <brush> stroke: root.selected
        ? (!root.enabled || input.pressed ? transparent : (root.dark
            ? @linear-gradient(180deg, #ffffff14 90.67%, #ffffff12 100%)
            : @linear-gradient(180deg, #ffffff14 90.67%, #00000066 100%)))
        : (!root.enabled || input.pressed ? (root.dark ? #ffffff12 : #0000000f) : (root.dark
            ? @linear-gradient(180deg, #ffffff17 0%, #ffffff12 8.33%)
            : @linear-gradient(180deg, #0000000f 90.58%, #00000029 100%)));

    border-radius: 4px;
    min-width: body.min-width;
    min-height: max(32px, body.min-height);
    preferred-width: round(body.preferred-width / 2px) * 2px;
    preferred-height: round(max(32px, body.preferred-height) / 2px) * 2px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    animate fill { duration: 83ms; easing: linear; }

    forward-focus: input;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-description: root.check-state == ToggleButtonState.indeterminate ? @tr("Indeterminate") : "";
    accessible-action-default => { root.activate(); }

    init => { root.reported-state = root.check-state; }
    changed check-state => { root.notify-state(); }

    function notify-state() {
        let state = root.check-state;
        if state != root.reported-state {
            root.reported-state = state;
            if state == ToggleButtonState.checked {
                root.checked();
            } else if state == ToggleButtonState.indeterminate {
                root.indeterminate();
            } else {
                root.unchecked();
            }
        }
    }

    function activate() {
        if root.enabled {
            root.check-state = root.check-state == ToggleButtonState.unchecked ? ToggleButtonState.checked
                : root.check-state == ToggleButtonState.checked && root.is-three-state
                    ? ToggleButtonState.indeterminate : ToggleButtonState.unchecked;
            root.notify-state();
            root.clicked();
        }
    }

    Rectangle {
        border-width: 1px;
        border-color: root.stroke;
        border-radius: root.border-radius;
        background: root.outer-fill ? root.fill : transparent;

        if !root.outer-fill: Rectangle {
            x: 1px;
            y: 1px;
            width: max(0px, parent.width - 2px);
            height: max(0px, parent.height - 2px);
            border-radius: max(0px, root.border-radius - 1px);
            background: root.fill;
        }
    }

    body := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;
        alignment: center;

        if root.text != "": Text {
            text: root.text;
            color: root.foreground;
            font-family: "Segoe UI Variable Text";
            font-size: 14px;
            vertical-alignment: center;
            accessible-role: none;
        }
        @children
    }

    input := ButtonInput {
        enabled: root.enabled;
        clicked => { root.activate(); }
    }

    if root.enabled && input.keyboard-focused: ButtonFocusVisual {
        control-width: root.width;
        control-height: root.height;
        control-radius: root.border-radius;
    }
}
