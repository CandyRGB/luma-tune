import { Palette } from "std-widgets.slint";
import { ButtonInput, ButtonFocusVisual } from "button_input.slint";
import { ButtonSurface } from "button_surface.slint";

export enum ToggleButtonState { unchecked, checked, indeterminate }

export component ToggleButton inherits Rectangle {
    in property <string> text;
    in property <string> accessible-name: root.text;
    in property <bool> enabled: true;
    in property <bool> is-three-state;
    in property <color> accent: Palette.accent-background;
    in-out property <ToggleButtonState> check-state: ToggleButtonState.unchecked;
    out property <bool> has-focus: input.has-focus;
    out property <color> foreground: surface.foreground;

    callback clicked();
    callback checked();
    callback unchecked();
    callback indeterminate();

    private property <ToggleButtonState> reported-state;
    private property <bool> selected: root.check-state == ToggleButtonState.checked;

    border-radius: 4px;
    min-width: surface.min-width;
    min-height: surface.min-height;
    preferred-width: surface.preferred-width;
    preferred-height: surface.preferred-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    forward-focus: input;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-description: root.check-state == ToggleButtonState.indeterminate ? @tr("Indeterminate") : "";
    accessible-action-default => { root.activate(); }

    init => { root.reported-state = root.check-state; }
    changed check-state => { root.notify-state(); }

    function notify-state() {
        let state = root.check-state;
        if state != root.reported-state {
            root.reported-state = state;
            if state == ToggleButtonState.checked {
                root.checked();
            } else if state == ToggleButtonState.indeterminate {
                root.indeterminate();
            } else {
                root.unchecked();
            }
        }
    }

    function activate() {
        if root.enabled {
            root.check-state = root.check-state == ToggleButtonState.unchecked ? ToggleButtonState.checked
                : root.check-state == ToggleButtonState.checked && root.is-three-state
                    ? ToggleButtonState.indeterminate : ToggleButtonState.unchecked;
            root.notify-state();
            root.clicked();
        }
    }

    surface := ButtonSurface {
        border-radius: root.border-radius;
        text: root.text;
        enabled: root.enabled;
        pressed: input.pressed;
        hovered: input.has-hover;
        selected: root.selected;
        accent: root.accent;
        @children
    }

    input := ButtonInput {
        enabled: root.enabled;
        clicked => { root.activate(); }
    }

    if root.enabled && input.keyboard-focused: ButtonFocusVisual {
        control-width: root.width;
        control-height: root.height;
        control-radius: root.border-radius;
    }
}
