// Generic breadcrumb bar: a horizontal trail of text crumbs separated by chevrons.
//
// App-agnostic: it renders whatever `[Crumb]` labels it is given and, when
// `interactive`, reports the index of a clicked crumb through `select(int)`.
// The last crumb is treated as the current location (emphasized, not clickable).
//
// Background matches the app's navigation rail by default: a solid
// `Palette.background` with a 3% foreground tint. Text and separators share one
// default blackness; clickable crumbs lighten on hover and further while pressed.

import { Palette } from "std-widgets.slint";
import { Icon, Icons } from "../icons.slint";

export struct Crumb {
    label: string,
}

export component BreadcrumbBar inherits Rectangle {
    in property <[Crumb]> items;
    // When false, crumbs are display-only (no hover, no clicks).
    in property <bool> interactive: false;
    // Full height of the bar; content is vertically centered within it.
    in property <length> bar-height: 42px;
    // Size of the chevron separator glyph.
    in property <length> separator-size: 10px;

    // Fired with the index of a clicked (non-current) crumb, only when interactive.
    callback select(int);

    height: root.bar-height;
    background: Palette.background;

    // Same 3% foreground tint the navigation rail uses, so the two read as one surface.
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Palette.foreground.with-alpha(0.03);
    }

    HorizontalLayout {
        spacing: 0px;
        alignment: start;

        for item[idx] in root.items : HorizontalLayout {
            spacing: 0px;
            horizontal-stretch: 0;
            alignment: center;

            if idx > 0 : Icon {
                icon: Icons.chevron;
                size: root.separator-size;
                height: root.bar-height;
                vertical-alignment: center;
                tint: Palette.foreground;
            }

            Rectangle {
                height: root.bar-height;
                border-radius: 4px;
                horizontal-stretch: 0;
                background: transparent;

                HorizontalLayout {
                    padding-left: 1px;
                    padding-right: 1px;
                    alignment: center;

                    Text {
                        text: item.label;
                        font-size: 13px;
                        vertical-alignment: center;
                        // Current (last) crumb stays full strength; earlier crumbs are
                        // links that fade on hover and fade further while pressed.
                        // Default blackness is the same for every crumb; only the
                        // clickable ones lighten on hover and further while pressed.
                        color: idx == root.items.length - 1
                            ? Palette.foreground
                            : (crumb-hit.pressed
                                ? Palette.foreground.with-alpha(0.40)
                                : (crumb-hit.has-hover
                                    ? Palette.foreground.with-alpha(0.50)
                                    : Palette.foreground));

                        animate color { duration: 100ms; }
                    }
                }

                crumb-hit := TouchArea {
                    enabled: root.interactive && idx < root.items.length - 1;
                    clicked => { root.select(idx); }
                }
            }
        }

        Rectangle { }
    }
}
