import { Button, LineEdit, Palette, Slider } from "std-widgets.slint";
import { NavRail } from "components/navigation/nav_rail.slint";
import { BreadcrumbBar, Crumb } from "components/navigation/breadcrumb_bar.slint";

export { ContrastTheme } from "components/contrast_theme.slint";

export enum NavPage {
    presets,
    apps,
    settings,
}

global Theme {
    out property <brush> card-stroke: Palette.foreground.with-alpha(0.10);
    out property <brush> divider: Palette.foreground.with-alpha(0.08);
}

// Maps the app's page enum to/from the integer id used by the generic NavRail.
global NavMap {
    public pure function page-id(page: NavPage) -> int {
        page == NavPage.presets ? 0 : (page == NavPage.apps ? 1 : 2)
    }

    public pure function page-from-id(id: int) -> NavPage {
        id == 0 ? NavPage.presets : (id == 1 ? NavPage.apps : NavPage.settings)
    }
}

component CardRow inherits VerticalLayout {
    in property <string> label;
    in property <float> minimum;
    in property <float> maximum;
    in property <string> suffix: "";
    in property <bool> divider: true;
    in-out property <float> value: 0;
    callback edited();

    spacing: 0;

    if root.divider : HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;

        Rectangle {
            height: 1px;
            background: Theme.divider;
        }
    }

    HorizontalLayout {
        height: 40px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        Text {
            text: root.label;
            width: 108px;
            vertical-alignment: center;
            color: Palette.foreground;
            font-size: 13px;
            overflow: elide;
        }

        Rectangle { }

        Slider {
            width: 240px;
            minimum: root.minimum;
            maximum: root.maximum;
            value <=> root.value;
            changed(v) => { root.edited(); }
        }

        Text {
            text: "\{Math.round(root.value * 100) / 100}\{root.suffix}";
            width: 56px;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: Palette.foreground.with-alpha(0.55);
            font-size: 12px;
        }
    }
}

component ThemeMock inherits Rectangle {
    in property <brush> page-color: #ffffff;
    in property <brush> pane-color: #f0f0f0;
    in property <brush> bar-color: #c9c9c9;
    in property <brush> accent-color: #005fb8;

    background: root.page-color;

    Rectangle {
        width: parent.width * 0.32;
        height: parent.height;
        background: root.pane-color;
    }

    Rectangle {
        x: parent.width * 0.32 + 10px;
        y: 16px;
        width: parent.width * 0.34;
        height: 6px;
        border-radius: 2px;
        background: root.bar-color;
    }

    Rectangle {
        x: parent.width * 0.32 + 10px;
        y: 30px;
        width: parent.width * 0.26;
        height: 6px;
        border-radius: 2px;
        background: root.bar-color;
    }

    Rectangle {
        x: parent.width * 0.32 + 10px;
        y: 46px;
        width: parent.width * 0.30;
        height: 6px;
        border-radius: 4px;
        background: root.accent-color;
    }

    Rectangle {
        x: parent.width * 0.32 + 10px;
        y: 62px;
        width: parent.width * 0.42;
        height: 8px;
        border-radius: 4px;
        background: root.bar-color;
    }
}

component ThemeTile inherits Rectangle {
    in property <int> mode: 0;
    in property <bool> selected: false;
    in property <string> label: "";
    callback pick();

    height: 112px;
    background: transparent;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 8px;

        Rectangle {
            width: parent.width;
            height: 84px;
            border-radius: 6px;
            border-width: 2px;
            border-color: root.selected ? Palette.accent-background : Palette.foreground.with-alpha(0.10);
            clip: true;

            if root.mode == 0 : Rectangle {
                background: transparent;

                ThemeMock {
                    x: 0;
                    width: parent.width / 2;
                    height: parent.height;
                    page-color: #fafafa;
                    pane-color: #f0f0f0;
                    bar-color: #c9c9c9;
                    accent-color: #005fb8;
                }

                ThemeMock {
                    x: parent.width / 2;
                    width: parent.width / 2;
                    height: parent.height;
                    page-color: #1c1c1c;
                    pane-color: #2c2c2c;
                    bar-color: #5c5c5c;
                    accent-color: #60cdff;
                }
            }

            if root.mode == 1 : ThemeMock {
                width: parent.width;
                height: parent.height;
                page-color: #fafafa;
                pane-color: #f0f0f0;
                bar-color: #c9c9c9;
                accent-color: #005fb8;
            }

            if root.mode == 2 : ThemeMock {
                width: parent.width;
                height: parent.height;
                page-color: #1c1c1c;
                pane-color: #2c2c2c;
                bar-color: #5c5c5c;
                accent-color: #60cdff;
            }
        }

        Text {
            width: parent.width;
            height: 16px;
            text: root.label;
            font-size: 12px;
            horizontal-alignment: center;
            color: Palette.foreground;
        }
    }

    hit := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.pick(); }
    }
}

component SectionHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> action;
    callback activate();

    height: 28px;
    spacing: 8px;

    Text {
        text: root.title;
        font-size: 14px;
        font-weight: 600;
        color: Palette.foreground;
        vertical-alignment: center;
    }

    Rectangle { }

    Rectangle {
        width: 92px;
        height: 24px;
        background: transparent;

        Text {
            text: root.action;
            font-size: 12px;
            color: Palette.accent-background;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => { root.activate(); }
        }
    }
}

export component AppWindow inherits Window {
    title: "LumaTune";
    width: 1040px;
    height: 640px;
    background: Palette.alternate-background;
    default-font-family: "Microsoft YaHei UI";

    in property <string> display-text: "";
    in-out property <string> status: "";

    in-out property <NavPage> page: NavPage.presets;
    in-out property <bool> nav-compact: false;

    in-out property <[string]> presets: [];
    in-out property <[string]> binding-rows: [];
    in-out property <int> current-preset: 0;
    in-out property <string> preset-name: "";
    in-out property <string> active-name: "";
    in-out property <bool> editing: false;

    in-out property <float> gamma: 1.0;
    in-out property <float> contrast: 1.0;
    in-out property <float> brightness: 0.0;
    in-out property <float> shadows: 0.0;
    in-out property <float> highlights: 0.0;
    in-out property <float> black-point: 0.0;
    in-out property <float> white-point: 1.0;
    in-out property <float> black-level: 0.0;
    in-out property <float> white-level: 1.0;
    in-out property <float> temperature: 6500;
    in-out property <float> tint: 0.0;
    in-out property <float> gain-r: 1.0;
    in-out property <float> gain-g: 1.0;
    in-out property <float> gain-b: 1.0;
    in-out property <bool> light-expanded: true;
    in-out property <bool> color-expanded: true;
    in-out property <bool> comparing: false;
    in-out property <int> theme-mode: 0;
    in property <[Crumb]> crumbs: root.page == NavPage.presets
        ? (root.editing && root.active-name != ""
            ? [{ label: "预设库" }, { label: root.active-name }]
            : [{ label: "预设库" }])
        : (root.page == NavPage.apps ? [{ label: "应用" }] : [{ label: "设置" }]);

    callback changed();
    callback reset();
    callback toggle-compare();
    callback choose(int);
    callback save-preset(string);
    callback delete-preset();
    callback bind-foreground();
    callback unbind-foreground();
    callback pick-theme(int);
    callback clear-selection();

    function apply-theme() {
        Palette.color-scheme = root.theme-mode == 1 ? ColorScheme.light : (root.theme-mode == 2 ? ColorScheme.dark : ColorScheme.unknown);
    }

    changed theme-mode => { root.apply-theme(); }

    bg := FocusScope {
        width: root.width;
        height: root.height;

        init => {
            bg.focus();
            root.apply-theme();
        }

        TouchArea {
            width: bg.width;
            height: bg.height;
            clicked => { bg.focus(); }
        }

        HorizontalLayout {
            NavRail {
                items: [
                    { id: NavMap.page-id(NavPage.presets), icon: @image-url("icons/library_16_regular.svg"), label: "预设库" },
                    { id: NavMap.page-id(NavPage.apps), icon: @image-url("icons/apps_16_regular.svg"), label: "应用" },
                ];
                footer: { id: NavMap.page-id(NavPage.settings), icon: @image-url("icons/settings_16_regular.svg"), label: "设置" };
                current: NavMap.page-id(root.page);
                compact <=> root.nav-compact;
                can-go-back: root.page == NavPage.presets && root.editing;
                back => {
                    root.editing = false;
                    root.active-name = "";
                    root.current-preset = -1;
                    root.clear-selection();
                    bg.focus();
                }
                selected(id) => {
                    root.page = NavMap.page-from-id(id);
                    bg.focus();
                    if (root.page == NavPage.presets) {
                        root.editing = false;
                    }
                }
            }

            Rectangle {
                background: Palette.background;

                Rectangle {
                    y: 0;
                    height: 42px;
                    background: Palette.background;

                    Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: Palette.foreground.with-alpha(0.03);
                    }

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 16px;

                        BreadcrumbBar {
                            items: root.crumbs;
                            interactive: root.page == NavPage.presets && root.editing;
                            select(idx) => {
                                root.editing = false;
                                root.active-name = "";
                                root.current-preset = -1;
                                root.clear-selection();
                            }
                        }

                        Rectangle { }
                    }
                }

                if root.page == NavPage.presets : Rectangle {
                    y: 42px;
                    height: parent.height - 42px;
                    background: transparent;

                    if !root.editing : Rectangle {
                        background: transparent;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 16px;

                            HorizontalLayout {
                                height: 32px;
                                spacing: 8px;

                                Button {
                                    icon: @image-url("icons/add_16_regular.svg");
                                    icon-size: 16px;
                                    colorize-icon: true;
                                    text: "新建预设";
                                    clicked => {
                                        root.reset();
                                        root.preset-name = "";
                                        root.active-name = "";
                                        root.editing = true;
                                    }
                                }

                                Rectangle { }
                            }

                            Rectangle {
                                background: Palette.background;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.card-stroke;
                                drop-shadow-blur: 8px;
                                drop-shadow-offset-y: 2px;
                                drop-shadow-color: Palette.foreground.with-alpha(0.05);
                                vertical-stretch: 0;
                                clip: true;

                                VerticalLayout {
                                    spacing: 0;

                                    for name[idx] in root.presets : Rectangle {
                                        height: 44px;
                                        background: idx == root.current-preset ? Palette.accent-background.with-alpha(0.10) : (row-hit.has-hover ? Palette.foreground.with-alpha(0.04) : transparent);

                                        if idx > 0 : Rectangle {
                                            x: 16px;
                                            y: 0;
                                            width: parent.width - 32px;
                                            height: 1px;
                                            background: Theme.divider;
                                        }

                                        HorizontalLayout {
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 8px;

                                            Text {
                                                text: name;
                                                vertical-alignment: center;
                                                font-size: 14px;
                                                color: Palette.foreground;
                                            }

                                            Rectangle { }

                                            Image {
                                                width: 12px;
                                                height: 12px;
                                                y: (parent.height - self.height) / 2;
                                                source: @image-url("icons/chevron_right_16_regular.svg");
                                                colorize: Palette.foreground.with-alpha(0.45);
                                            }
                                        }

                                        row-hit := TouchArea {
                                            clicked => {
                                                root.current-preset = idx;
                                                root.choose(idx);
                                                root.editing = true;
                                                bg.focus();
                                            }
                                        }
                                    }

                                    if root.presets.length == 0 : Rectangle {
                                        height: 64px;

                                        Text {
                                            text: "还没有预设";
                                            font-size: 13px;
                                            color: Palette.foreground.with-alpha(0.45);
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Rectangle { }
                        }
                    }

                    if root.editing : Rectangle {
                        background: transparent;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 16px;

                            HorizontalLayout {
                                height: 32px;
                                spacing: 8px;

                                LineEdit {
                                    text <=> root.preset-name;
                                    placeholder-text: "预设名称";
                                    width: 232px;
                                }

                                Button {
                                    icon: @image-url("icons/save_16_regular.svg");
                                    icon-size: 16px;
                                    colorize-icon: true;
                                    text: "保存";
                                    clicked => { root.save-preset(root.preset-name); }
                                }

                                Button {
                                    icon: @image-url("icons/delete_16_regular.svg");
                                    icon-size: 16px;
                                    colorize-icon: true;
                                    text: "删除";
                                    clicked => { root.delete-preset(); }
                                }

                                Rectangle { }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                vertical-stretch: 1;

                                scroller := Flickable {
                                    mouse-drag-pan-enabled: false;

                                    VerticalLayout {
                                        spacing: 16px;

                                        VerticalLayout {
                                            spacing: 8px;

                                            SectionHeader {
                                                title: "光照";
                                                action: root.light-expanded ? "收起" : "显示全部 9 项";
                                                activate => { root.light-expanded = !root.light-expanded; }
                                            }

                                            Rectangle {
                                                background: Palette.background;
                                                border-radius: 8px;
                                                border-width: 1px;
                                                border-color: Theme.card-stroke;
                                                drop-shadow-blur: 8px;
                                                drop-shadow-offset-y: 2px;
                                                drop-shadow-color: Palette.foreground.with-alpha(0.05);
                                                clip: true;

                                                VerticalLayout {
                                                    spacing: 0;

                                                    CardRow {
                                                        label: "Gamma";
                                                        minimum: 0.2;
                                                        maximum: 5.0;
                                                        divider: false;
                                                        value <=> root.gamma;
                                                        edited => { root.changed(); }
                                                    }
                                                    CardRow {
                                                        label: "对比度";
                                                        minimum: 0.2;
                                                        maximum: 3.0;
                                                        value <=> root.contrast;
                                                        edited => { root.changed(); }
                                                    }
                                                    CardRow {
                                                        label: "亮度";
                                                        minimum: -0.12;
                                                        maximum: 0.12;
                                                        value <=> root.brightness;
                                                        edited => { root.changed(); }
                                                    }
                                                    CardRow {
                                                        label: "暗部";
                                                        minimum: -0.3;
                                                        maximum: 0.3;
                                                        value <=> root.shadows;
                                                        edited => { root.changed(); }
                                                    }
                                                    CardRow {
                                                        label: "高光";
                                                        minimum: -0.3;
                                                        maximum: 0.3;
                                                        value <=> root.highlights;
                                                        edited => { root.changed(); }
                                                    }

                                                    if root.light-expanded : VerticalLayout {
                                                        spacing: 0;

                                                        CardRow {
                                                            label: "输入黑位";
                                                            minimum: 0.0;
                                                            maximum: 0.5;
                                                            value <=> root.black-point;
                                                            edited => { root.changed(); }
                                                        }
                                                        CardRow {
                                                            label: "输入白位";
                                                            minimum: 0.5;
                                                            maximum: 1.0;
                                                            value <=> root.white-point;
                                                            edited => { root.changed(); }
                                                        }
                                                        CardRow {
                                                            label: "输出黑位";
                                                            minimum: 0.0;
                                                            maximum: 0.15;
                                                            value <=> root.black-level;
                                                            edited => { root.changed(); }
                                                        }
                                                        CardRow {
                                                            label: "输出白位";
                                                            minimum: 0.7;
                                                            maximum: 1.0;
                                                            value <=> root.white-level;
                                                            edited => { root.changed(); }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            spacing: 8px;

                                            SectionHeader {
                                                title: "色彩";
                                                action: root.color-expanded ? "收起" : "显示全部 5 项";
                                                activate => { root.color-expanded = !root.color-expanded; }
                                            }

                                            Rectangle {
                                                background: Palette.background;
                                                border-radius: 8px;
                                                border-width: 1px;
                                                border-color: Theme.card-stroke;
                                                drop-shadow-blur: 8px;
                                                drop-shadow-offset-y: 2px;
                                                drop-shadow-color: Palette.foreground.with-alpha(0.05);
                                                clip: true;

                                                VerticalLayout {
                                                    spacing: 0;

                                                    CardRow {
                                                        label: "色温";
                                                        minimum: 1000;
                                                        maximum: 10000;
                                                        suffix: " K";
                                                        divider: false;
                                                        value <=> root.temperature;
                                                        edited => { root.changed(); }
                                                    }
                                                    CardRow {
                                                        label: "色调";
                                                        minimum: -1.0;
                                                        maximum: 1.0;
                                                        value <=> root.tint;
                                                        edited => { root.changed(); }
                                                    }

                                                    if root.color-expanded : VerticalLayout {
                                                        spacing: 0;

                                                        CardRow {
                                                            label: "红增益";
                                                            minimum: 0.5;
                                                            maximum: 1.5;
                                                            value <=> root.gain-r;
                                                            edited => { root.changed(); }
                                                        }
                                                        CardRow {
                                                            label: "绿增益";
                                                            minimum: 0.5;
                                                            maximum: 1.5;
                                                            value <=> root.gain-g;
                                                            edited => { root.changed(); }
                                                        }
                                                        CardRow {
                                                            label: "蓝增益";
                                                            minimum: 0.5;
                                                            maximum: 1.5;
                                                            value <=> root.gain-b;
                                                            edited => { root.changed(); }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            height: 32px;
                                            Button {
                                                icon: @image-url("icons/arrow_swap_16_regular.svg");
                                                icon-size: 16px;
                                                colorize-icon: true;
                                                text: root.comparing ? "对比中" : "对比";
                                                clicked => { root.toggle-compare(); }
                                            }
                                            Button {
                                                icon: @image-url("icons/arrow_clockwise_16_regular.svg");
                                                icon-size: 16px;
                                                colorize-icon: true;
                                                text: "重置";
                                                clicked => { root.reset(); }
                                            }
                                            Rectangle { }
                                        }

                                        VerticalLayout {
                                            spacing: 4px;

                                            Text {
                                                text: root.status;
                                                color: Palette.foreground.with-alpha(0.75);
                                                font-size: 12px;
                                                wrap: word-wrap;
                                                visible: root.status != "";
                                            }

                                            Text {
                                                text: root.display-text;
                                                font-size: 12px;
                                                color: Palette.foreground.with-alpha(0.45);
                                            }
                                        }
                                    }
                                }

                                bar := Rectangle {
                                    width: 6px;
                                    background: transparent;

                                    property <length> view-h: scroller.height;
                                    property <length> content-h: scroller.content-height;
                                    property <length> thumb-h: Math.max(32px, self.view-h * self.view-h / Math.max(self.content-h, 1px));
                                    property <length> travel: Math.max(self.content-h - self.view-h, 0px);
                                    property <float> progress: self.travel > 0px ? -scroller.content-y / self.travel : 0;

                                    Rectangle {
                                        width: 6px;
                                        border-radius: 4px;
                                        background: Palette.foreground.with-alpha(0.32);
                                        visible: bar.travel > 0px;
                                        height: bar.thumb-h;
                                        y: bar.progress * (bar.view-h - bar.thumb-h);
                                    }
                                }

                            }
                        }
                    }
                }

                if root.page == NavPage.apps : Rectangle {
                    y: 42px;
                    height: parent.height - 42px;
                    background: transparent;

                    VerticalLayout {
                        padding: 24px;
                        spacing: 16px;

                        Text {
                            text: "绑定的应用切到前台时自动套用对应预设，切走后恢复桌面参数。";
                            font-size: 12px;
                            color: Palette.foreground.with-alpha(0.6);
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            height: 32px;
                            spacing: 8px;

                            Button {
                                icon: @image-url("icons/add_16_regular.svg");
                                icon-size: 16px;
                                colorize-icon: true;
                                text: "绑定当前前台应用到选中预设";
                                clicked => { root.bind-foreground(); }
                            }
                            Button {
                                icon: @image-url("icons/dismiss_16_regular.svg");
                                icon-size: 16px;
                                colorize-icon: true;
                                text: "解除前台应用的绑定";
                                clicked => { root.unbind-foreground(); }
                            }
                            Rectangle { }
                        }

                        Rectangle {
                            background: Palette.background;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.card-stroke;
                            drop-shadow-blur: 8px;
                            drop-shadow-offset-y: 2px;
                            drop-shadow-color: Palette.foreground.with-alpha(0.05);
                            clip: true;

                            VerticalLayout {
                                spacing: 0;

                                for row[idx] in root.binding-rows : Rectangle {
                                    height: 40px;

                                    if idx > 0 : Rectangle {
                                        x: 16px;
                                        y: 0;
                                        width: parent.width - 32px;
                                        height: 1px;
                                        background: Theme.divider;
                                    }

                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        Text {
                                            text: row;
                                            vertical-alignment: center;
                                            font-size: 13px;
                                            color: Palette.foreground;
                                        }
                                    }
                                }

                                if root.binding-rows.length == 0 : Rectangle {
                                    height: 56px;
                                    Text {
                                        text: "还没有预设";
                                        font-size: 13px;
                                        color: Palette.foreground.with-alpha(0.45);
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle { }
                    }
                }

                if root.page == NavPage.settings : Rectangle {
                    y: 42px;
                    height: parent.height - 42px;
                    background: transparent;

                    VerticalLayout {
                        padding: 24px;
                        spacing: 16px;

                        Text {
                            text: "界面外观与行为，改动立即生效。";
                            font-size: 12px;
                            color: Palette.foreground.with-alpha(0.6);
                            wrap: word-wrap;
                        }

                        SectionHeader {
                            title: "外观";
                            action: "";
                        }

                        Rectangle {
                            background: Palette.background;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.card-stroke;
                            drop-shadow-blur: 8px;
                            drop-shadow-offset-y: 2px;
                            drop-shadow-color: Palette.foreground.with-alpha(0.05);
                            vertical-stretch: 0;
                            clip: true;

                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text {
                                    text: "应用模式";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Palette.foreground;
                                }

                                Text {
                                    text: "跟随系统时，随 Windows 的浅色 / 深色设置自动切换。";
                                    font-size: 12px;
                                    color: Palette.foreground.with-alpha(0.6);
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    height: 112px;
                                    spacing: 12px;

                                    ThemeTile {
                                        width: 132px;
                                        mode: 0;
                                        label: "跟随系统";
                                        selected: root.theme-mode == 0;
                                        pick => { root.pick-theme(0); }
                                    }

                                    ThemeTile {
                                        width: 132px;
                                        mode: 1;
                                        label: "浅色";
                                        selected: root.theme-mode == 1;
                                        pick => { root.pick-theme(1); }
                                    }

                                    ThemeTile {
                                        width: 132px;
                                        mode: 2;
                                        label: "深色";
                                        selected: root.theme-mode == 2;
                                        pick => { root.pick-theme(2); }
                                    }

                                    Rectangle { }
                                }
                            }
                        }

                        Rectangle { }
                    }
                }
            }
        }
    }
}
