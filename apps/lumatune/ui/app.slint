import { LineEdit, Palette, Slider } from "std-widgets.slint";

export enum Icon {
    library,
    apps,
    settings,
    save,
    trash,
    compare,
    reset,
    add,
    cancel,
    back,
    menu,
    chevron,
}

export enum NavPage {
    presets,
    apps,
    settings,
}

global Theme {
    out property <brush> card-stroke: Palette.foreground.with-alpha(0.10);
    out property <brush> divider: Palette.foreground.with-alpha(0.08);
}

