        : root.icon == Icon.compare ? "M 14.78 2.22 L 19.28 6.72 C 19.54 6.98 19.57 7.4 19.35 7.69 L 19.28 7.77 L 14.78 12.27 A 0.75 0.75 0 0 1 13.65 11.3 L 13.72 11.22 L 16.94 8 L 5.24 8 A 0.75 0.75 0 0 1 4.5 7.35 L 4.5 7.25 C 4.5 6.87 4.77 6.55 5.14 6.5 L 16.94 6.5 L 13.72 3.28 A 0.75 0.75 0 0 1 13.65 2.3 L 13.72 2.22 A 0.75 0.75 0 0 1 14.7 2.15 Z M 14.78 2.22 L 19.28 6.72 Z M 19.5 16.65 L 19.5 16.75 C 19.5 17.13 19.22 17.45 18.86 17.49 L 18.76 17.5 L 7.06 17.5 L 10.28 20.72 C 10.55 20.99 10.58 21.4 10.36 21.7 L 10.28 21.78 A 0.75 0.75 0 0 1 9.31 21.85 L 9.22 21.78 L 4.72 17.28 A 0.75 0.75 0 0 1 4.65 16.31 L 4.72 16.22 L 9.22 11.72 A 0.75 0.75 0 0 1 10.36 12.7 L 10.28 12.78 L 7.07 16 L 18.76 16 C 19.14 16 19.46 16.28 19.5 16.65 L 19.5 16.75 Z"
