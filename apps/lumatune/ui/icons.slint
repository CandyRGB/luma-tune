import { Palette } from "std-widgets.slint";

export enum Icons {
    library,
    apps,
    settings,
    save,
    trash,
    compare,
    reset,
    add,
    cancel,
    back,
    menu,
    chevron,
}

export component Icon inherits Text {
    in property <Icons> icon: Icons.library;
    in property <length> size: 16px;
    in property <brush> tint: Palette.foreground;

    text: root.icon == Icons.library ? "\u{e8f1}"
        : root.icon == Icons.apps ? "\u{e8a9}"
        : root.icon == Icons.settings ? "\u{e713}"
        : root.icon == Icons.save ? "\u{e74e}"
        : root.icon == Icons.trash ? "\u{e74d}"
        : root.icon == Icons.compare ? "\u{e8ab}"
        : root.icon == Icons.reset ? "\u{e72c}"
        : root.icon == Icons.add ? "\u{e710}"
        : root.icon == Icons.cancel ? "\u{e711}"
        : root.icon == Icons.back ? "\u{e72b}"
        : root.icon == Icons.menu ? "\u{e700}"
        : "\u{e76c}";

    font-family: "Segoe Fluent Icons";
    font-size: root.size;
    color: root.tint;
    width: root.size + 4px;
    height: root.size + 4px;
    horizontal-alignment: center;
    vertical-alignment: center;
}
