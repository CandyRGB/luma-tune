import { Palette } from "std-widgets.slint";

export enum Icon {
    library,
    apps,
    settings,
    save,
    trash,
    compare,
    reset,
    add,
    cancel,
    back,
    menu,
    chevron,
}

export component Glyph inherits Image {
    in property <Icon> icon: Icon.library;
    in property <length> size: 18px;
    in property <brush> tint: Palette.foreground;

    width: root.size + 4px;
    height: root.size + 4px;
    colorize: root.tint;
    image-fit: contain;

    source: root.icon == Icon.library ? @image-url("icons/library_16_regular.svg")
        : root.icon == Icon.apps ? @image-url("icons/grid_16_regular.svg")
        : root.icon == Icon.settings ? @image-url("icons/settings_16_regular.svg")
        : root.icon == Icon.save ? @image-url("icons/save_16_regular.svg")
        : root.icon == Icon.trash ? @image-url("icons/delete_16_regular.svg")
        : root.icon == Icon.compare ? @image-url("icons/arrow_swap_16_regular.svg")
        : root.icon == Icon.reset ? @image-url("icons/arrow_clockwise_16_regular.svg")
        : root.icon == Icon.add ? @image-url("icons/add_16_regular.svg")
        : root.icon == Icon.cancel ? @image-url("icons/dismiss_16_regular.svg")
        : root.icon == Icon.back ? @image-url("icons/arrow_left_16_regular.svg")
        : root.icon == Icon.menu ? @image-url("icons/navigation_16_regular.svg")
        : @image-url("icons/chevron_right_16_regular.svg");
}
